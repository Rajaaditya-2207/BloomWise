# Environment Variables for KrishiMitra AI Agent

# Google Gemini API Key (Required)
# Get from: https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# OpenRouter Configuration (New)
# Get from: https://openrouter.ai/keys
VITE_OPENROUTER_CHAT_KEY=your_chat_agent_key_here
VITE_OPENROUTER_BG_KEY=your_background_agent_key_here

# Supabase Configuration (Required)
# Get from: Supabase Project Settings > API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Optional: Background Agent Settings
VITE_AGENT_INTERVAL_MS=1800000  # 30 minutes default
VITE_AGENT_ENABLED=true
